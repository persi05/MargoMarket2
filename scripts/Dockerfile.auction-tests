FROM eclipse-temurin:21-jdk-alpine
WORKDIR /app
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY src src
RUN --mount=type=cache,target=/root/.m2 chmod +x mvnw && ./mvnw test && cp -a /root/.m2 /opt/test-m2
CMD ["./mvnw", "-o", "-Dmaven.repo.local=/opt/test-m2/repository", "-Dtest=AuctionIntegrationTest", "test"]
